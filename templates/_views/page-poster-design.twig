{# -- Base Page Layout -- #}
{# ----------------------------------------------------------------- #}
{% extends '_base/body.twig' %}

{# -- Page Variables -- #}
{# ----------------------------------------------------------------- #}
{% set headline = post.meta('post_headline')|default(post.title) %}
{% set subheadline = post.meta('post_subheadline')|default(null) %}
{% set bannerImage = post.meta('banner_image') ?? post.thumbnail|default(null) %}
{% set bannerImages = post.meta('banner_images')|default(null) %}
{% set bannerVideo = post.meta('banner_video_embed')|default(null) %}
{% set bannerType = post.meta('banner_type')|default('default') %}
{% set button = post.meta('banner_button')|default(null) %}
{% set posters = post.meta('poster_grid')|default(null) %}
{% set pageBuilder = post.meta('section_builder')|default(null) %}

{# -- Page Template -- #}
{# ----------------------------------------------------------------- #}
{% block content %}

    <article class="o-page">

        {% include '_components/banner.twig' with {
            params: {
                headline: headline,
                text: subheadline,
                style: bannerType,
                image: bannerImage,
                images: bannerImages,
                video: bannerVideo,
                button: button
            }
        } only %}

        {% if post.content is not empty %}
            <section class="c-intro" data-module-scroll>
                <div class="u-wysiwyg" data-scroll-trigger>
                    {{ post.content }}
                </div>
            </section>
        {% endif %}

        <section class="o-section is-posters" data-module-scroll>

            {# <!-- Sorting Dropdown -->
            <form method="get" class="logos-sorting-form">
                <label for="sort">Sort by:</label>
                <select name="sort" id="sort" onchange="this.form.submit()">
                    <option value="alphabetical" {% if app.request.get('sort') == 'alphabetical' %}selected{% endif %}>Alphabetical</option>
                    <option value="date" {% if app.request.get('sort') == 'date' %}selected{% endif %}>Date</option>
                    <option value="random" {% if app.request.get('sort') == 'random' %}selected{% endif %}>Random</option>
                </select>
            </form>
            <!-- Filter by Job Type -->
            <form method="get" class="logos-filter-form">
                <fieldset>
                    <legend>Filter by Job Type:</legend>
                    {% for job_type in job_types %}
                        <label>
                            <input
                                type="checkbox"
                                name="job_type[]"
                                value="{{ job_type.slug }}"
                                {% if job_type.slug in app.request.get('job_type', []) %}checked{% endif %}
                                onchange="this.form.submit()"
                            >
                            {{ job_type.name }}
                        </label>
                    {% endfor %}
                </fieldset>
            </form> #}

            <article class="c-poster-grid" data-module-masonry data-module-fancybox>
                {% for poster in posters %}
                    {% set renderedPoster = get_image(poster.poster_image) %}
                    {% set posterTitle = poster.poster_title %}
                    {% set posterDesc = poster.poster_description %}
                    {% set posterClient = poster.poster_client %}
                    {% set posterYear = poster.poster_year %}
                    {% set posterLink = poster.poster_link %}
                    <button class="c-poster" data-fancybox data-src="#poster-{{ renderedPoster.id }}">
                        <picture class="c-media">
                            <img src="{{ renderedPoster.src('medium') }}" alt="{{ renderedPoster.alt }}" width="{{ renderedPoster.sizes.medium.width }}" height="{{ renderedPoster.sizes.medium.height }}" class="c-media__image" sizes="(min-width: 900px) 25vw, (min-width: 600px) 33vw, 50vw" srcset="{{ renderedPoster.src('medium') }} 600w, {{ renderedPoster.src('large') }} 900w" loading="lazy" />
                        </picture>
                        <div class="c-poster__modal" id="poster-{{ renderedPoster.id }}" style="display: none;">
                            <div class="c-poster__modal--image">
                                <img src="{{ renderedPoster.src('large') }}" alt="{{ renderedPoster.alt }}" width="{{ renderedPoster.sizes.medium.width }}" height="{{ renderedPoster.sizes.medium.height }}" class="c-poster__image" sizes="(min-width: 900px) 25vw, (min-width: 600px) 33vw, 50vw" srcset="{{ renderedPoster.src('large') }} 600w, {{ renderedPoster.src('1536x1536') }} 900w" loading="lazy" />
                            </div>
                            <div class="c-poster__modal--content" data-selectable>
                                <h3 class="u-headline">{{ posterTitle }}</h3>
                                {% if posterClient or posterYear %}
                                    <strong class="u-caption">{{ posterClient }}, {{ posterYear }}</strong>
                                {% endif %}
                                {% if posterDesc %}
                                    <div class="u-wysiwyg">
                                        {{ posterDesc }}
                                    </div>
                                {% endif %}
                                {% if posterLink %}
                                    {% include '_elements/button.twig' with {
                                        params: {
                                            url: posterLink.url,
                                            text: "Buy Online",
                                            target: posterLink.target,
                                            primary: true
                                        }
                                    } only %}
                                {% endif %}
                            </div>
                        </div>
                    </button>
                {% endfor %}
            </article>

        </section>

        {% include '_partials/page-builder.twig' with {
            params: {
                sections: pageBuilder
            }
        } only %}

        {% if relatedPosts is not empty %}
            <footer class="o-page__related has-{{ relatedPosts|length }}-columns" data-module-scroll>
                <h3 class="u-subheadline" data-scroll-trigger>Related Reading</h3>
                {% include '_components/related-posts.twig' with {
                    related: relatedPosts
                } only %}
            </footer>
        {% endif %}

    </article>

{% endblock %}
