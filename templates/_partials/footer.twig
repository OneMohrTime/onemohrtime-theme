{# -- Partial Variables -- #}
{# ----------------------------------------------------------------- #}

{% set this = {
    logo: params.logo,
    navigation: params.menu,
    social: params.social,
    large: params.banner,
    small: params.about,
    flags: params.flags,
    shop: params.shop,
    dribbble: params.dribbble,
    siteName: params.siteName,
    siteUrl: params.siteUrl
} %}

{# -- Partial Template -- #}
{# ----------------------------------------------------------------- #}

<footer class="o-site__footer">
    <section id="colophon" class="c-footer">
        <h2 class="u-screen-reader-text">Footer Info</h2>

        <div class="c-footer__primary">
            <div class="c-footer__branding">
                {% if this.logo %}
                    <a href="{{ this.siteUrl }}" class="c-media">
                        <img src="{{ this.logo.url }}" alt="Logo for {{ this.siteName }}" class="c-media__image" />
                    </a>
                {% endif %}
                <div class="c-fittext">
                    <div class="c-fittext__headline" data-module-fit-text>{{ this.large }}</div>
                </div>
            </div>
        </div>

        <div class="c-footer__secondary">
            <nav class="c-footer__nav">
                <h3 class="u-eyebrow">Pages of Interest</h3>
                <ul class="c-menu">
                    {% for item in this.navigation.get_items %}
                        <li class="c-menuItem">
                            <a href="{{ item.url }}" class="u-highlight">{{ item.title }}</a>
                        </li>
                    {% endfor %}
                </ul>
            </nav>
            <nav class="c-footer__social">
                <h3 class="u-eyebrow">Social Media</h3>
                <ul class="c-menu">
                    {% for profile in this.social %}
                        {% set profile = profile.profile %}
                        <li class="c-footer__social-profile">
                            <a href="{{ profile.url }}" target="_blank" rel="noopener noreferrer nofollow">
                                <span class="u-screen-reader-text">{{ profile.title }}</span>
                                {{ source('_elements/svg/social-' ~ profile.title|lower ~ '.svg') }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
                {% if this.dribbble %}
                    <a href="{{ this.dribbble.url }}" class="c-media is-badge"{% if this.dribbble.target == '_blank' %} target="_blank" rel="noopener noreferrer nofollow"{% endif %}>
